# ==============================================================================
# Aurawell Nutra — Example / Test Environment Template
# ==============================================================================
# Copy this file to `.env` or reference these variables in your Vercel Project Settings.
# Never commit real secrets, passwords, or live keys to Git.

# --- Database (PostgreSQL / Neon) ---------------------------------------------
# Neon pooled connection string (used by Prisma and Next.js server runtime)
DATABASE_URL="postgresql://neondb_owner:<PASSWORD>@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Neon direct / unpooled connection string (required for running `npx prisma migrate deploy`)
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:<PASSWORD>@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Neon branch (optional, defaults to production)
NEON_BRANCH=production

# --- App & Admin URLs (Vercel / Production / Test) ----------------------------
# Public base URL of the store (e.g. https://<your-project-name>.vercel.app or https://yourdomain.com)
NEXT_PUBLIC_APP_URL=https://test.aurawellnutra.in

# Admin panel base URL
# On Vercel (single domain), set to the same as NEXT_PUBLIC_APP_URL. The admin panel is served at /admin.
ADMIN_APP_URL=https://test.aurawellnutra.in

# Comma-separated Host headers that should serve the admin panel
# E.g. <your-project-name>.vercel.app,admin.yourdomain.com,localhost:3001
ADMIN_HOSTS=test.aurawellnutra.in

# --- Session & Security -------------------------------------------------------
# Secure random string (at least 32 characters). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=-_EtEI6_kxFQZQxb-GhjU6zdmIUPo7Xr5vFPVKBtKizKKKRW6YodocPMVbo4M

# --- Payment Gateway (Razorpay) ----------------------------------------------
# Razorpay API credentials — https://dashboard.razorpay.com/app/keys (use test keys for dev/test)
RAZORPAY_KEY_ID=rzp_test_TvfgHLdeF38pRX
RAZORPAY_KEY_SECRET=PrTOWcS7Lg8Z4EdAjMUx5r1p
RAZORPAY_WEBHOOK_SECRET=04dafeeb79319942b25fc345720be01485a0dbf4ee1c6b918592ea01b815b3ee

# --- Email Notifications (SMTP) -----------------------------------------------
# SMTP server for order confirmation and notification emails
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=support@aaurawell.com
SMTP_PASSWORD=Aaurawell@1316
SMTP_FROM_EMAIL="Aaurawell Nutra <support@aaurawell.com>"
ADMIN_NOTIFICATION_EMAIL=support@aaurawell.com


